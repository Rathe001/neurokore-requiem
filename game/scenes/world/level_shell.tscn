[gd_scene load_steps=11 format=3]

; Generic level scene: WorldEnvironment + LevelBuilder + EnemiesContainer +
; PlayersContainer + HUD + Camera. The LevelBuilder's `layout` export
; decides what level is built. Players are instantiated dynamically into
; PlayersContainer (one per peer in multiplayer, or one for the local
; player in single-player) so the same scene structure works for both
; modes. Enemies are spawned into EnemiesContainer; in multiplayer a
; MultiplayerSpawner attached there replicates them to all peers.

[ext_resource type="Script" path="res://scripts/prototype/prototype_root.gd" id="script_root"]
[ext_resource type="Script" path="res://scripts/prototype/prototype_camera.gd" id="script_camera"]
[ext_resource type="Script" path="res://scripts/prototype/players_container.gd" id="script_players_container"]
[ext_resource type="Script" path="res://scripts/prototype/enemies_container.gd" id="script_enemies_container"]
[ext_resource type="Script" path="res://scripts/prototype/pickups_container.gd" id="script_pickups_container"]
[ext_resource type="Script" path="res://scripts/level/level_builder.gd" id="script_builder"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_hud.tscn" id="scene_hud"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_enemy.tscn" id="scene_enemy"]
[ext_resource type="Resource" path="res://resources/level/layouts/dungeon_demo.tres" id="layout"]

[sub_resource type="Environment" id="env_test"]
background_mode = 1
background_color = Color(0.002, 0.003, 0.006, 1)
tonemap_mode = 2
tonemap_exposure = 1.0
ambient_light_source = 0
ambient_light_energy = 0.0
glow_enabled = true
glow_intensity = 0.7
glow_strength = 1.0
glow_bloom = 0.05
glow_blend_mode = 1
glow_hdr_threshold = 0.9
glow_hdr_scale = 2.0
volumetric_fog_enabled = true
volumetric_fog_density = 0.02
volumetric_fog_albedo = Color(0.7, 0.75, 0.85, 1)
volumetric_fog_emission = Color(0.0, 0.0, 0.0, 1)
volumetric_fog_anisotropy = 0.3
volumetric_fog_length = 40.0

; agent_height matches the enemy CROUCH_HEIGHT (1.0) so the navmesh routes
; through low-ceiling crawlspaces. Enemies detect overhead clearance at run
; time and shrink their capsule when entering one — without that, a 1.7m
; capsule would still bump the ceiling slab even though the navmesh allowed
; the path.
;
; agent_height and agent_max_climb are deliberately exact multiples of
; cell_height (0.25). The navmesh baker rounds them to voxel units and
; warns when the source value isn't aligned — keeping them snapped
; silences "Property X is ceiled/floored to cell_height voxel units"
; spam in the editor on every layout build.
[sub_resource type="NavigationMesh" id="navmesh_level"]
agent_radius = 0.5
agent_height = 1.0
agent_max_climb = 0.5
cell_size = 0.25
cell_height = 0.25
geometry_parsed_geometry_type = 1
geometry_source_geometry_mode = 2
geometry_source_group_name = &"structures"

[node name="LevelShell" type="Node3D"]
script = ExtResource("script_root")
spawn_boss_on_ready = false

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("env_test")

[node name="LevelBuilder" type="Node3D" parent="."]
script = ExtResource("script_builder")
layout = ExtResource("layout")

[node name="NavigationRegion3D" type="NavigationRegion3D" parent="."]
unique_name_in_owner = true
navigation_mesh = SubResource("navmesh_level")

; EnemiesContainer holds all spawned enemies. In multiplayer, the
; MultiplayerSpawner child below replicates spawn / despawn to all peers.
; The spawner is baked into the scene (not created at runtime) so it's
; in the tree BEFORE LevelBuilder._ready() spawns enemies — otherwise
; the host's first wave of enemies misses replication entirely (the
; spawner only watches add_child events that happen after it exists).
[node name="EnemiesContainer" type="Node3D" parent="."]
script = ExtResource("script_enemies_container")

[node name="MultiplayerSpawner" type="MultiplayerSpawner" parent="EnemiesContainer"]
_spawnable_scenes = PackedStringArray("res://scenes/prototype/prototype_enemy.tscn")
spawn_path = NodePath("..")

; PickupsContainer holds all world pickups (items + credits). In
; multiplayer, a MultiplayerSpawner with a custom spawn_function
; replicates drops to all peers with serialized item data.
[node name="PickupsContainer" type="Node3D" parent="."]
script = ExtResource("script_pickups_container")

; PlayersContainer's _ready spawns the local player BEFORE this node's
; siblings (HUD, Camera) hit _ready, so their group lookups for &"player"
; succeed on first try. The container's script also handles per-peer
; spawn / despawn when networked.
[node name="PlayersContainer" type="Node3D" parent="."]
script = ExtResource("script_players_container")

[node name="HUD" parent="." instance=ExtResource("scene_hud")]

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 14, 0)
current = true
projection = 1
size = 22.0
near = 0.1
far = 100.0
script = ExtResource("script_camera")
; target is set at runtime by PlayersContainer once the local player
; is spawned — the scene file no longer hardcodes a NodePath because
; the player path varies (one shared container, dynamic children).
