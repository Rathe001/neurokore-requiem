; Replication config for MP — host syncs enemy state to clients. Enemies are
; always authority=1 (host). Clients skip AI and follow synced values.
; replication_mode 1 = always (every tick). net_state mirrors the State enum
; as an int so clients can pick the right animation without running AI.
[sub_resource type="SceneReplicationConfig" id="repl_config"]
properties/0/path = NodePath(".:global_position")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath("Visual:rotation")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:net_health")
properties/2/spawn = true
properties/2/replication_mode = 1
properties/3/path = NodePath(".:net_max_health")
properties/3/spawn = true
properties/3/replication_mode = 1
properties/4/path = NodePath(".:net_state")
properties/4/spawn = true
properties/4/replication_mode = 1

