[gd_scene load_steps=10 format=3]

; Ranged variant of prototype_enemy.tscn — same model, same animations, only
; the EnemyClass differs. Spawners can swap this in via room_def.enemy_scene
; (or hand-place via interactable slots) wherever ranged behaviour is wanted.
; Visual differentiation beyond the floor ring is a polish pass.

[ext_resource type="Script" path="res://scripts/prototype/prototype_enemy.gd" id="script_enemy"]
[ext_resource type="PackedScene" path="res://art/3d/characters/quaternius/UAL1_Standard.glb" id="char_model"]
[ext_resource type="Shader" path="res://scripts/prototype/health_bar.gdshader" id="shader_health_bar"]
[ext_resource type="Resource" path="res://resources/enemies/classes/basic_ranged.tres" id="class_basic_ranged"]

[sub_resource type="CapsuleShape3D" id="shape_enemy"]
radius = 0.6
height = 1.7

[sub_resource type="StandardMaterial3D" id="mat_ring_enemy"]
albedo_color = Color(0, 0, 0, 0)
emission_enabled = true
emission = Color(0.35, 0.6, 1.0, 1)
emission_energy_multiplier = 3.0
shading_mode = 0
transparency = 1

[sub_resource type="TorusMesh" id="mesh_ring_enemy"]
material = SubResource("mat_ring_enemy")
inner_radius = 0.5
outer_radius = 0.62

[sub_resource type="ShaderMaterial" id="mat_health_bar"]
render_priority = 10
shader = ExtResource("shader_health_bar")
shader_parameter/back_color = Color(0.12, 0.14, 0.18, 0.95)
shader_parameter/fill_color = Color(1.0, 0.28, 0.32, 1.0)
shader_parameter/border_color = Color(0.02, 0.03, 0.05, 1.0)
shader_parameter/border_thickness = 0.12

[sub_resource type="QuadMesh" id="mesh_health_bar"]
material = SubResource("mat_health_bar")
size = Vector2(1.0, 0.16)

[node name="PrototypeRangedEnemy" type="CharacterBody3D"]
script = ExtResource("script_enemy")
enemy_class = ExtResource("class_basic_ranged")

[node name="Visual" type="Node3D" parent="."]

[node name="Character" parent="Visual" instance=ExtResource("char_model")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)

[node name="FloorRing" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.03, 0)
mesh = SubResource("mesh_ring_enemy")

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
shape = SubResource("shape_enemy")

[node name="HealthBar" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0)
visible = false
mesh = SubResource("mesh_health_bar")

[node name="NavigationAgent3D" type="NavigationAgent3D" parent="."]
radius = 0.6
height = 1.7
path_desired_distance = 0.6
target_desired_distance = 1.5
path_max_distance = 5.0
avoidance_enabled = false
