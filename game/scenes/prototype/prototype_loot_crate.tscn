[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/prototype/prototype_loot_crate.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://assets/models/objects/loot_crate/loot_crate.glb" id="crate_visual"]

; Collision box matches the .glb's bottom half (`zCrateLarge_Bottom`,
; ~1.49 × 0.79 × 1.19m at scale 1.0) so the player can't walk through
; the closed crate. Centred at half-height so the base sits on the floor.
; Depth (z) tightened to the MEASURED visual AABB (0.85) — was 1.2,
; leaving a ~0.18m invisible lip on each long side.
[sub_resource type="BoxShape3D" id="shape_crate"]
size = Vector3(1.5, 0.8, 0.9)

[node name="LootCrate" type="StaticBody3D"]
collision_layer = 64
collision_mask = 0
script = ExtResource("1_script")
display_name = "Loot Crate"

; Sci-Fi-Crate .glb bbox is 2.76 × 1.13 × 1.55m at scale 1.0. Collision
; below is 1.5 × 0.8 × 1.2m. Uniform 0.55 scale shrinks the model so its
; widest axis fits the collision footprint; smaller axes have a bit of
; clearance which is fine.
;
; The .glb's local origin sits above the bottom of the visible mesh,
; so at the LootCrate's Y=0 the visual floats above the floor. Y offset
; of -0.31 (~ scale 0.55 × the .glb's bbox half-height) seats the
; visible bottom flush with the floor.
[node name="Visual" parent="." instance=ExtResource("crate_visual")]
transform = Transform3D(0.55, 0, 0, 0, 0.55, 0, 0, 0, 0.55, 0, -0.31, 0)

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.4, 0)
shape = SubResource("shape_crate")
