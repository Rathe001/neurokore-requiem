[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/prototype/prototype_drone.gd" id="script_drone"]
[ext_resource type="PackedScene" path="res://assets/models/objects/automaton_drone/automaton_drone.glb" id="drone_visual"]

[sub_resource type="SphereShape3D" id="shape_drone"]
radius = 0.13

; Untargetable hover drone for the Automaton Drone Swarm perk.
;
; CharacterBody3D + collision_layer = 0 / collision_mask = 1 lets the drone
; collide with WORLD geometry (walls, doors) without being detectable by
; enemies, the player, or any other body that scans layers. Untargetable
; per the perk description, but still constrained by walls so it doesn't
; clip through corridors and shoot from outside the room.
[node name="PrototypeDrone" type="CharacterBody3D"]
collision_layer = 0
collision_mask = 1
script = ExtResource("script_drone")

; Visual is the Blenderkit Sci-fi Droid Robot .glb at scale 0.3. Source
; bbox is 2.29 × 1.8 × 2.7m with the pivot offset above the visual
; centre (Y min ≈ -1.22). At scale 0.3 the drone lands at ~70 × 54 × 80cm
; and the visual centre sits ~37cm below the hover point — looks natural
; for a hovering sci-fi orb (the body hangs slightly below its tracker).
[node name="Mesh" parent="." instance=ExtResource("drone_visual")]
transform = Transform3D(0.3, 0, 0, 0, 0.3, 0, 0, 0, 0.3, 0, 0, 0)

[node name="Collision" type="CollisionShape3D" parent="."]
shape = SubResource("shape_drone")

; ProximityLighting-aware glow tinted to the drone's accent colour so it
; lights nearby surfaces as it hovers. Shadow off — at 5+ drones at horde
; density the shadow updates would dominate the frame budget.
[node name="Glow" type="OmniLight3D" parent="."]
light_color = Color(0.55, 0.78, 0.85, 1)
light_energy = 1.0
omni_range = 2.4
omni_attenuation = 2.0
shadow_enabled = false
light_volumetric_fog_energy = 0.0
