[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/prototype/prototype_exit.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://assets/models/objects/elevator/elevator.glb" id="2_elevator"]

; Player-interactable footprint sized to the elevator's visual base. Layer
; 64 (interactable hover). NOTE: the player's collision mask includes 64,
; so this box DOES block movement — even at 0.2m tall there's no step-up
; logic, so the player can't board the platform. Interaction works via
; the footprint-aware range check (HoverableInteractable.interact_extent),
; which treats "pressed against the edge" as in range of the centre.
; Footprint matches the model's scaled XZ extent (3.44 × 3.36).
; Depth (z) matches the MEASURED visual AABB (2.46), not the model's
; scaled bbox estimate (3.36) — the old value left a 0.45m invisible
; blocking lip on the platform's front and back.
[sub_resource type="BoxShape3D" id="shape_platform"]
size = Vector3(3.44, 0.2, 2.46)

[node name="Exit" type="StaticBody3D"]
collision_layer = 64
collision_mask = 0
script = ExtResource("1_script")
display_name = "Elevator"

; Scale 1.8× to read as a proper boarding platform (~3.4m wide vs ~1.9m
; raw). Y +1.23 lifts the geometric origin up so the model's base
; (which sits 0.68m below origin in the glb) ends up at world Y=0
; instead of clipping into the floor.
[node name="Elevator" parent="." instance=ExtResource("2_elevator")]
transform = Transform3D(1.8, 0, 0, 0, 1.8, 0, 0, 0, 1.8, 0, 1.23, 0)

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.1, 0)
shape = SubResource("shape_platform")
