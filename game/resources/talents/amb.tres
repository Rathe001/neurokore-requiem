[gd_resource type="Resource" script_class="TalentTree" load_steps=4 format=3]

; Enculted (amb) talent tree — Doomsayer support nodes.
;
; Each TalentNode places itself at (tier, node_idx) on the 8×3 grid
; the talents panel renders. Effects use the PerkEffect schema; the
; aggregate keys here are read by gameplay code via
; TalentState.get_aggregate(kind).

[ext_resource type="Script" path="res://scripts/talents/talent_node.gd" id="node_script"]
[ext_resource type="Script" path="res://scripts/talents/talent_tree.gd" id="tree_script"]
[ext_resource type="Script" path="res://scripts/perks/perk_effect.gd" id="effect_script"]

[sub_resource type="Resource" id="effect_amb_t1_n0_dot"]
script = ExtResource("effect_script")
kind = &"doomsayer_dot_per_tick"
magnitude = 4.0

[sub_resource type="Resource" id="node_amb_t1_n0"]
script = ExtResource("node_script")
id = &"amb_t1_n0_dot"
label = "Aura of Dread"
description = "Your Doomsayer aura damages nearby enemies over time, heaviest at your feet and fading to nothing at the edge. Damage scales with Ambition."
tier = 0
node_idx = 0
effects = [SubResource("effect_amb_t1_n0_dot")]

[resource]
script = ExtResource("tree_script")
nodes = [SubResource("node_amb_t1_n0")]
