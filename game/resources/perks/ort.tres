[gd_resource type="Resource" script_class="PerkLadder" load_steps=8 format=3]

; Count / Countess (ort) tier perks — Exile.
;
; The first hit on an enemy applies a curse for EXILE_CURSE_DURATION
; seconds. While cursed, that enemy takes +X% damage from any source.
; Subsequent hits inside the active window do NOT refresh the timer —
; the duration is fixed from the moment of application, so the player
; has to commit damage inside it. When the timer expires on a still-
; alive target, the player auto-fires a fixed massive hitscan (not tied
; to any equipped weapon — works barehanded / mid-reload).
;
; Tier deltas (additive aggregate; totals 10 / 20 / 40):
;   T1 grants +10
;   T2 grants +10
;   T3 grants +20
;
; Auto-shot damage scales with main stat (Orthodoxy for Count) via
; AttributeState.get_player_damage_mult, so investing Orthodoxy for tier
; unlocks ALSO makes the expire shot hit harder.

[ext_resource type="Script" path="res://scripts/perks/perk.gd" id="perk_script"]
[ext_resource type="Script" path="res://scripts/perks/perk_effect.gd" id="effect_script"]
[ext_resource type="Script" path="res://scripts/perks/perk_ladder.gd" id="ladder_script"]

[sub_resource type="Resource" id="effect_ort_t1_curse"]
script = ExtResource("effect_script")
kind = &"exile_curse_damage_pct"
magnitude = 10.0

[sub_resource type="Resource" id="perk_ort_t1"]
script = ExtResource("perk_script")
id = &"ort_t1"
label = "Exile I"
description = "Hits curse the target for several seconds. Cursed enemies take +10% damage; if the curse runs out, you auto-fire a massive shot at them."
effects = [SubResource("effect_ort_t1_curse")]

[sub_resource type="Resource" id="effect_ort_t2_curse"]
script = ExtResource("effect_script")
kind = &"exile_curse_damage_pct"
magnitude = 10.0

[sub_resource type="Resource" id="perk_ort_t2"]
script = ExtResource("perk_script")
id = &"ort_t2"
label = "Exile II"
description = "Cursed enemies take +20% damage."
effects = [SubResource("effect_ort_t2_curse")]

[sub_resource type="Resource" id="effect_ort_t3_curse"]
script = ExtResource("effect_script")
kind = &"exile_curse_damage_pct"
magnitude = 20.0

[sub_resource type="Resource" id="perk_ort_t3"]
script = ExtResource("perk_script")
id = &"ort_t3"
label = "Exile III"
description = "Cursed enemies take +40% damage. The expire shot is doctrine made manifest."
effects = [SubResource("effect_ort_t3_curse")]

[resource]
script = ExtResource("ladder_script")
perks = [SubResource("perk_ort_t1"), SubResource("perk_ort_t2"), SubResource("perk_ort_t3")]
