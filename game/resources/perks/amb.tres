[gd_resource type="Resource" script_class="PerkLadder" load_steps=11 format=3]

; Enculted (amb) tier perks — Doomsayer.
;
; The player constantly emits an aura with linear distance falloff. On
; every DOOMSAYER_TICK_INTERVAL (currently 0.4s) the aura does TWO things:
;
;   1. DAMAGE OVER TIME — every uncharmed enemy in range takes per-tick
;      damage scaled by 1.0 - (dist / radius). 100% at the player's
;      centre, 0% at the aura edge. Damage scales with main stat
;      (Ambition for Enculted) via get_player_damage_mult.
;
;   2. CHARM — if the controlled-enemy count is below the per-tier
;      cap, the closest uncharmed enemy in range gets charmed. The
;      cap acts as a natural rate-limit: charms keep flowing until
;      full, then stop until a controlled enemy dies. No FIFO eviction.
;
; Charmed enemies are PLAYER-FRIENDLY — immune to all player-sourced
; damage and debuffs (Doomsayer DoT, Exile curse, IED traps, Telekinesis,
; drone fire, weapon hits). They fight for the player until killed by
; OTHER enemies. Once dead, the slot opens for a new charm.
;
; Tier deltas (additive aggregates):
;   T1 grants +5% damage scale + 1 charm slot   →  5%, 1 max charm
;   T2 grants +5% damage scale + 1 charm slot   → 10%, 2 max charms
;   T3 grants +10% damage scale + 1 charm slot  → 20%, 3 max charms
;
; The doomsayer_proc_pct aggregate is no longer read by code (DoT
; values come from DOOMSAYER_DOT_PER_TICK_PER_TIER on PrototypePlayer);
; kept here as a "this perk unlocked" sentinel until the migration
; settles. doomsayer_max_charms is still authoritative for the cap.

[ext_resource type="Script" path="res://scripts/perks/perk.gd" id="perk_script"]
[ext_resource type="Script" path="res://scripts/perks/perk_effect.gd" id="effect_script"]
[ext_resource type="Script" path="res://scripts/perks/perk_ladder.gd" id="ladder_script"]

[sub_resource type="Resource" id="effect_amb_t1_proc"]
script = ExtResource("effect_script")
kind = &"doomsayer_proc_pct"
magnitude = 5.0

[sub_resource type="Resource" id="effect_amb_t1_charms"]
script = ExtResource("effect_script")
kind = &"doomsayer_max_charms"
magnitude = 1.0

[sub_resource type="Resource" id="perk_amb_t1"]
script = ExtResource("perk_script")
id = &"amb_t1"
label = "Doomsayer I"
description = "An aura of dread surrounds you. Damages nearby enemies over time (heaviest at your feet, fading to nothing at the edge). Charms 1 enemy at a time — they fight for you until killed."
effects = [SubResource("effect_amb_t1_proc"), SubResource("effect_amb_t1_charms")]

[sub_resource type="Resource" id="effect_amb_t2_proc"]
script = ExtResource("effect_script")
kind = &"doomsayer_proc_pct"
magnitude = 5.0

[sub_resource type="Resource" id="effect_amb_t2_charms"]
script = ExtResource("effect_script")
kind = &"doomsayer_max_charms"
magnitude = 1.0

[sub_resource type="Resource" id="perk_amb_t2"]
script = ExtResource("perk_script")
id = &"amb_t2"
label = "Doomsayer II"
description = "The aura tightens. Stronger DoT; up to 2 charmed enemies fighting for you."
effects = [SubResource("effect_amb_t2_proc"), SubResource("effect_amb_t2_charms")]

[sub_resource type="Resource" id="effect_amb_t3_proc"]
script = ExtResource("effect_script")
kind = &"doomsayer_proc_pct"
magnitude = 10.0

[sub_resource type="Resource" id="effect_amb_t3_charms"]
script = ExtResource("effect_script")
kind = &"doomsayer_max_charms"
magnitude = 1.0

[sub_resource type="Resource" id="perk_amb_t3"]
script = ExtResource("perk_script")
id = &"amb_t3"
label = "Doomsayer III"
description = "Maximum DoT, up to 3 charmed enemies fighting for you. Walking apocalypse — the herd unravels around you."
effects = [SubResource("effect_amb_t3_proc"), SubResource("effect_amb_t3_charms")]

[resource]
script = ExtResource("ladder_script")
perks = [SubResource("perk_amb_t1"), SubResource("perk_amb_t2"), SubResource("perk_amb_t3")]
