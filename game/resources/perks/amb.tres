[gd_resource type="Resource" script_class="PerkLadder" load_steps=8 format=3]

; Enculted (amb) tier perks — Doomsayer.
;
; The player constantly emits a charm aura. On every DOOMSAYER_TICK_INTERVAL
; (currently 0.4s) the aura looks for the nearest uncharmed enemy in range:
; if the controlled-enemy count is below the per-tier cap, that enemy gets
; charmed. The cap acts as a natural rate-limit — charms keep flowing
; until full, then stop until a controlled enemy dies. No FIFO eviction.
;
; Damage-over-time is NOT part of this perk — the "Aura of Dread" talent
; (AMB T1 N0) gates it via TalentState.get_aggregate(
; &"doomsayer_dot_per_tick"). Players who skip that talent get pure
; mind-control with no offensive aura.
;
; Charmed enemies are PLAYER-FRIENDLY — immune to all player-sourced
; damage and debuffs (Aura of Dread DoT, Exile curse, IED traps,
; Telekinesis, drone fire, weapon hits). They fight for the player until
; killed by OTHER enemies. Once dead, the slot opens for a new charm.
; Bosses, named monsters, and rare-pack members are immune to the charm
; itself (see PrototypeEnemy.is_charmable).
;
; Tier deltas (additive aggregates):
;   T1 grants 1 charm slot   →  1 max charm
;   T2 grants 1 charm slot   →  2 max charms
;   T3 grants 1 charm slot   →  3 max charms

[ext_resource type="Script" path="res://scripts/perks/perk.gd" id="perk_script"]
[ext_resource type="Script" path="res://scripts/perks/perk_effect.gd" id="effect_script"]
[ext_resource type="Script" path="res://scripts/perks/perk_ladder.gd" id="ladder_script"]

[sub_resource type="Resource" id="effect_amb_t1_charms"]
script = ExtResource("effect_script")
kind = &"doomsayer_max_charms"
magnitude = 1.0

[sub_resource type="Resource" id="perk_amb_t1"]
script = ExtResource("perk_script")
id = &"amb_t1"
label = "Doomsayer I"
description = "A charm aura surrounds you, converting up to 1 follower to your cult — they fight for you until they die. (Allocate the Aura of Dread talent to add damage.)"
effects = [SubResource("effect_amb_t1_charms")]

[sub_resource type="Resource" id="effect_amb_t2_charms"]
script = ExtResource("effect_script")
kind = &"doomsayer_max_charms"
magnitude = 1.0

[sub_resource type="Resource" id="perk_amb_t2"]
script = ExtResource("perk_script")
id = &"amb_t2"
label = "Doomsayer II"
description = "The aura tightens. Up to 2 followers converted to your cult."
effects = [SubResource("effect_amb_t2_charms")]

[sub_resource type="Resource" id="effect_amb_t3_charms"]
script = ExtResource("effect_script")
kind = &"doomsayer_max_charms"
magnitude = 1.0

[sub_resource type="Resource" id="perk_amb_t3"]
script = ExtResource("perk_script")
id = &"amb_t3"
label = "Doomsayer III"
description = "Up to 3 followers in your cult. The herd unravels around you and joins you."
effects = [SubResource("effect_amb_t3_charms")]

[resource]
script = ExtResource("ladder_script")
perks = [SubResource("perk_amb_t1"), SubResource("perk_amb_t2"), SubResource("perk_amb_t3")]
