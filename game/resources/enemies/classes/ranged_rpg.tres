[gd_resource type="Resource" script_class="EnemyClass" load_steps=5 format=3]

; Ranged + RPG — slow explosive rocket launcher. Stays at mid-range and lobs
; rockets with AoE blast. Very long cooldown and visible windup give the player
; time to scatter. Devastating if you clump. The "area denial" archetype.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_projectile.tscn" id="projectile_scene"]
[ext_resource type="Resource" path="res://resources/enemies/skills/rpg_attack.tres" id="basic_attack"]
[ext_resource type="Resource" path="res://resources/enemies/skills/multi_shot.tres" id="multi_shot"]

[resource]
script = ExtResource("script")
id = &"ranged_rpg"
label = "Rocketeer"
weapon_id = &"rpg"
basic_attack = ExtResource("basic_attack")
skill_pool = [ExtResource("multi_shot")]
attack_mode = 1
attack_range = 16.0
attack_cooldown = 4.5
attack_windup = 0.7
attack_damage_mult = 1.2
projectile_scene = ExtResource("projectile_scene")
projectile_speed = 12.0
projectile_max_range = 18.0
accuracy = 0.70
ranged_kite_distance = 10.0
projectile_is_bullet = true
support_role = 0
