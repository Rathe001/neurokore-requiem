[gd_resource type="Resource" script_class="EnemyClass" load_steps=7 format=3]

; Melee + sledgehammer — slow, heavy-hitting bruiser with knockback. Punishes
; standing still; the long cooldown and windup give the player time to dodge.
; Pairs with melee_blade for a fast/slow melee split in the same room.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]
[ext_resource type="Resource" path="res://resources/enemies/skills/sledgehammer_attack.tres" id="basic_attack"]
[ext_resource type="Resource" path="res://resources/enemies/skills/ground_slam.tres" id="ground_slam"]
[ext_resource type="Resource" path="res://resources/enemies/skills/enrage.tres" id="enrage"]
[ext_resource type="Resource" path="res://resources/enemies/skills/leap_attack.tres" id="leap_attack"]
[ext_resource type="PackedScene" path="res://assets/characters/crimson_vein_titan/crimson_vein_titan.fbx" id="char_mesh"]

[resource]
script = ExtResource("script")
id = &"melee_sledgehammer"
label = "Heavy Bruiser"
weapon_id = &"sledgehammer"
character_mesh = ExtResource("char_mesh")
mesh_yaw_offset = 3.14159
mesh_tint = Color(1.0, 0.55, 0.2, 1.0)
basic_attack = ExtResource("basic_attack")
skill_pool = [ExtResource("ground_slam"), ExtResource("enrage"), ExtResource("leap_attack")]
attack_mode = 0
attack_range = 2.6
attack_cooldown = 2.8
attack_windup = 0.7
attack_damage_mult = 1.3
melee_cone_deg = 90.0
melee_knockback = 3.0
support_role = 0
