[gd_resource type="Resource" script_class="EnemyClass" load_steps=6 format=3]

; Ranged + damage-buff combo. Stays at kite distance and fires bolts, while
; pulsing a +25% damage buff to any allies (or itself) within 7m every
; 4 seconds. Player feels the buff via meatier melee swings from the
; bruisers it's standing behind — kill the buffer first to defang the pack.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_projectile.tscn" id="projectile_scene"]
[ext_resource type="Resource" path="res://resources/enemies/skills/multi_shot.tres" id="multi_shot"]
[ext_resource type="Resource" path="res://resources/enemies/skills/laser_pistol_attack.tres" id="basic_attack"]
[ext_resource type="PackedScene" path="res://assets/characters/crimson_vein_titan/crimson_vein_titan.fbx" id="char_mesh"]

