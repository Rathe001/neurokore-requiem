[gd_resource type="Resource" script_class="EnemyClass" load_steps=5 format=3]

; Ranged + SMG — rapid, inaccurate spray at close range. Low per-shot damage
; compensated by volume of fire. Kites close (6m) and rushes in, so the player
; feels them as aggressive flankers rather than passive turrets.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_projectile.tscn" id="projectile_scene"]
[ext_resource type="Resource" path="res://resources/enemies/skills/smg_attack.tres" id="basic_attack"]
[ext_resource type="Resource" path="res://resources/enemies/skills/multi_shot.tres" id="multi_shot"]

[resource]
script = ExtResource("script")
id = &"ranged_smg"
label = "SMG Grunt"
weapon_id = &"smg"
basic_attack = ExtResource("basic_attack")
skill_pool = [ExtResource("multi_shot")]
attack_mode = 1
attack_range = 8.0
attack_cooldown = 2.0
attack_windup = 0.3
attack_damage_mult = 0.4
projectile_scene = ExtResource("projectile_scene")
projectile_speed = 22.0
projectile_max_range = 12.0
accuracy = 0.55
ranged_kite_distance = 6.0
projectile_is_bullet = true
support_role = 0
