[gd_resource type="Resource" script_class="EnemyClass" load_steps=2 format=3]

; Melee + heal-aura combo. Walks in like a basic_melee bruiser but every
; 3 seconds tops up nearby allies (and itself) by 8% of their max HP.
; Player should prioritise these in mixed packs — letting one tick is a
; hard reset on whatever damage they were chipping at the front line.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]

[resource]
script = ExtResource("script")
id = &"melee_healer"
label = "Field Medic"
attack_mode = 0
attack_range = 2.2
attack_cooldown = 1.6
attack_windup = 0.4
attack_damage_mult = 0.8
melee_cone_deg = 80.0
melee_knockback = 5.0
support_role = 1
support_radius = 6.0
support_interval = 3.0
support_magnitude = 0.08
