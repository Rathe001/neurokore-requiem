[gd_resource type="Resource" script_class="EnemyClass" load_steps=5 format=3]

; Melee + heal-aura combo. Walks in like a blade fighter but every
; 12 seconds tops up nearby allies (and itself) by a 10-20% chunk of max HP
; (rolled per target). Letting a tick land is a heavy reset, so the heal
; cadence is slow enough that a focused player can burst the medic before
; the next pulse.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]
[ext_resource type="Resource" path="res://resources/enemies/skills/ground_slam.tres" id="ground_slam"]
[ext_resource type="Resource" path="res://resources/enemies/skills/blade_attack.tres" id="basic_attack"]
[ext_resource type="PackedScene" path="res://assets/characters/molten_sentinel/molten_sentinel.fbx" id="char_mesh"]

[resource]
script = ExtResource("script")
id = &"melee_healer"
label = "Field Medic"
weapon_id = &"blade"
character_mesh = ExtResource("char_mesh")
mesh_yaw_offset = 3.14159
mesh_tint = Color(0.55, 1.0, 0.55, 1.0)
basic_attack = ExtResource("basic_attack")
skill_pool = [ExtResource("ground_slam")]
attack_mode = 0
attack_range = 2.2
attack_cooldown = 1.6
attack_windup = 0.4
attack_damage_mult = 0.8
melee_cone_deg = 80.0
melee_knockback = 0.0
support_role = 1
support_radius = 6.0
support_interval = 12.0
support_magnitude = 0.10
support_magnitude_max = 0.20
