[gd_resource type="Resource" script_class="EnemyClass" load_steps=6 format=3]

; Ranged + LMG — sustained suppressive fire from mid-range. Longer bursts than
; SMG (6 rounds vs 4) with a longer pause between volleys. Kites at moderate
; distance and pins the player down. The "wall of bullets" archetype.

