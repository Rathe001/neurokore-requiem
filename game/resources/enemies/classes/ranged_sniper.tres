[gd_resource type="Resource" script_class="EnemyClass" load_steps=6 format=3]

; Ranged + sniper rifle — very slow, very accurate, very punishing. Stays far
; back (14m kite) and lands near-guaranteed hits. The long cooldown and windup
; telegraph the shot so the player can sprint to cover or close distance.
; Standing still against a sniper is a death sentence.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_projectile.tscn" id="projectile_scene"]
[ext_resource type="Resource" path="res://resources/enemies/skills/sniper_rifle_attack.tres" id="basic_attack"]
[ext_resource type="Resource" path="res://resources/enemies/skills/multi_shot.tres" id="multi_shot"]
[ext_resource type="PackedScene" path="res://assets/characters/military_man/Idle.fbx" id="char_mesh"]

[resource]
script = ExtResource("script")
id = &"ranged_sniper"
label = "Sniper"
weapon_id = &"sniper_rifle"
character_mesh = ExtResource("char_mesh")
mesh_yaw_offset = 3.14159
basic_attack = ExtResource("basic_attack")
skill_pool = [ExtResource("multi_shot")]
attack_mode = 1
attack_range = 12.0
attack_cooldown = 4.5
attack_windup = 0.9
attack_damage_mult = 1.5
projectile_scene = ExtResource("projectile_scene")
projectile_speed = 28.0
projectile_max_range = 22.0
accuracy = 0.90
ranged_kite_distance = 9.0
projectile_is_bullet = true
support_role = 0
