[gd_resource type="Resource" script_class="EnemyClass" load_steps=5 format=3]

; Ranged + heal-aura combo. Hangs back at kite distance firing accurate laser
; pistol shots while pulsing heals to nearby allies. The ranged counterpart to
; melee_healer — harder to reach, but less dangerous up close. "Kill the medic
; first" priority target that forces the player to push through the frontline.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_projectile.tscn" id="projectile_scene"]
[ext_resource type="Resource" path="res://resources/enemies/skills/laser_pistol_attack.tres" id="basic_attack"]
[ext_resource type="Resource" path="res://resources/enemies/skills/multi_shot.tres" id="multi_shot"]

[resource]
script = ExtResource("script")
id = &"ranged_healer"
label = "Combat Medic"
weapon_id = &"laser_pistol"
basic_attack = ExtResource("basic_attack")
skill_pool = [ExtResource("multi_shot")]
attack_mode = 1
attack_range = 12.0
attack_cooldown = 1.4
attack_windup = 0.25
attack_damage_mult = 0.6
projectile_scene = ExtResource("projectile_scene")
projectile_speed = 26.0
projectile_max_range = 14.0
accuracy = 0.80
ranged_kite_distance = 8.0
support_role = 1
support_radius = 6.0
support_interval = 12.0
support_magnitude = 0.10
support_magnitude_max = 0.20
