[gd_resource type="Resource" script_class="EnemyClass" load_steps=6 format=3]

; Default melee profile — mirrors the pre-EnemyClass constants exactly so
; assigning this to existing enemies is a no-op behaviourally. Use as the
; starting point for variant melee enemies (heavy / fast / brawler) by
; tweaking attack_range, attack_cooldown, attack_damage_mult, etc.

[ext_resource type="Script" path="res://scripts/enemies/enemy_class.gd" id="script"]
[ext_resource type="Resource" path="res://resources/enemies/skills/basic_melee_attack.tres" id="basic_attack"]
[ext_resource type="Resource" path="res://resources/enemies/skills/ground_slam.tres" id="ground_slam"]
[ext_resource type="Resource" path="res://resources/enemies/skills/enrage.tres" id="enrage"]
[ext_resource type="PackedScene" path="res://assets/characters/riot_guard_male_1/riot_guard_male_1.fbx" id="char_mesh"]

[resource]
script = ExtResource("script")
id = &"basic_melee"
label = "Basic Melee"
weapon_id = &"blade"
character_mesh = ExtResource("char_mesh")
mesh_yaw_offset = 3.14159
mesh_tint = Color(1.0, 1.0, 1.0, 1.0)
basic_attack = ExtResource("basic_attack")
skill_pool = [ExtResource("ground_slam"), ExtResource("enrage")]
attack_mode = 0
attack_range = 2.2
attack_cooldown = 2.0
attack_windup = 0.4
attack_damage_mult = 1.0
melee_cone_deg = 80.0
melee_knockback = 0.0
support_role = 0
