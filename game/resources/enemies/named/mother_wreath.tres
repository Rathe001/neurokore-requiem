[gd_resource type="Resource" script_class="NamedMonster" load_steps=5 format=3]

; Mother Wreath — vampiric field medic. The most dangerous combination on
; paper: HP-leech effect + AoE heal aura on a 3s tick means anything this
; named touches recovers fast. Low damage on her own swings (medic, not
; brawler) — kill her allies first to deny the heals, OR burst her down.
; Higher min_level than the other two — she's a late-game escalation.

[ext_resource type="Script" path="res://scripts/enemies/named_monster.gd" id="script"]
[ext_resource type="Resource" path="res://resources/enemies/classes/melee_healer.tres" id="class_melee_healer"]
[ext_resource type="Resource" path="res://resources/enemies/affixes/vampiric.tres" id="affix_vampiric"]
[ext_resource type="Resource" path="res://resources/enemies/affixes/tough.tres" id="affix_tough"]

