[gd_resource type="Resource" script_class="NamedMonster" load_steps=5 format=3]

; Vex, the Sundered — fast ranged buffer with extra firepower. Hits twice
; as fast as a normal Tactical Officer and pulses bigger damage buffs to
; whatever's standing in front of it. Player should silence-and-burst this
; first if it's surrounded by allies, otherwise the pack chip damage
; compounds quickly.

[ext_resource type="Script" path="res://scripts/enemies/named_monster.gd" id="script"]
[ext_resource type="Resource" path="res://resources/enemies/classes/ranged_buffer.tres" id="class_ranged_buffer"]
[ext_resource type="Resource" path="res://resources/enemies/affixes/frenzied.tres" id="affix_frenzied"]
[ext_resource type="Resource" path="res://resources/enemies/affixes/jagged.tres" id="affix_jagged"]

[resource]
