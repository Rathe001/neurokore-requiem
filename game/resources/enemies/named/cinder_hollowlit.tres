[gd_resource type="Resource" script_class="NamedMonster" load_steps=5 format=3]

; Cinder, Hollow-Lit — burning melee bruiser with a tough shell. Slow but
; punishing in close quarters; the burning effect (when status framework
; lands) means players who tank a hit will keep taking chip damage. Deep
; orange ring telegraphs the heat theme.

[ext_resource type="Script" path="res://scripts/enemies/named_monster.gd" id="script"]
[ext_resource type="Resource" path="res://resources/enemies/classes/basic_melee.tres" id="class_basic_melee"]
[ext_resource type="Resource" path="res://resources/enemies/affixes/burning.tres" id="affix_burning"]
[ext_resource type="Resource" path="res://resources/enemies/affixes/tough.tres" id="affix_tough"]

[resource]
