[gd_resource type="Resource" script_class="EnemySkill" load_steps=3 format=3]

; Shotgun basic attack — 6-pellet spread at close range. Each pellet is its
; own projectile with independent aim spread. Devastating if the enemy is
; close, but pellets scatter at range. Mirrors the player shotgun's buckshot.

[ext_resource type="Script" path="res://scripts/enemies/enemy_skill.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_projectile.tscn" id="projectile_scene"]

