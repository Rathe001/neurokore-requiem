[gd_resource type="Resource" script_class="EnemySkill" load_steps=3 format=3]

; RPG basic attack — slow explosive rocket. Long windup telegraphs the shot,
; blast radius damages everything near impact. Very punishing if you stand
; still, but the slow projectile and long cooldown give the player time to
; dodge. Mirrors the player RPG's heavy-impact feel — blast kept in lockstep
; with the player rocket's 2m (was 3.5 when the player's was 4).

[ext_resource type="Script" path="res://scripts/enemies/enemy_skill.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_projectile.tscn" id="projectile_scene"]

[resource]
script = ExtResource("script")
id = &"rpg_attack"
display_name = "Rocket"
targeting_mode = 2
damage_mult = 1.0
skill_range = 16.0
cooldown = 4.5
wind_up = 0.7
projectile_scene = ExtResource("projectile_scene")
projectile_speed = 12.0
projectile_max_range = 18.0
projectile_count = 1
projectile_blast_radius = 2.0
