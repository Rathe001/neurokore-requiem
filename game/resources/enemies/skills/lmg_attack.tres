[gd_resource type="Resource" script_class="EnemySkill" load_steps=3 format=3]

; LMG basic attack — sustained 6-round burst of suppressive fire. Longer burst
; than SMG with a longer cooldown between volleys. Mid-range, moderate accuracy.
; Mirrors the player LMG's sustained chatter feel.

