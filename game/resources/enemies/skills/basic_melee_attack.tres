[gd_resource type="Resource" script_class="EnemySkill" load_steps=2 format=3]

; Default melee basic attack — mirrors the pre-skill-system inline params
; on basic_melee.tres exactly. Assigning this as basic_attack on a melee
; EnemyClass is a no-op behaviourally.

[ext_resource type="Script" path="res://scripts/enemies/enemy_skill.gd" id="script"]

[resource]
script = ExtResource("script")
id = &"basic_melee_attack"
display_name = "Melee Strike"
targeting_mode = 0
damage_mult = 1.0
skill_range = 2.2
cooldown = 1.6
wind_up = 0.4
cone_deg = 80.0
knockback = 0.0
