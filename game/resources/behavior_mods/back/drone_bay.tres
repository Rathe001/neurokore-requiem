[resource]
script = ExtResource("1_script")
id = &"drone_bay"
display_name = "Combat Drone Bay"
slot = &"back"
description = "A small autonomous drone hovers above you and fires at locked or hovered targets at a fraction of your weapon DPS.

Trade: −X% reload speed (the drone intercepts your shells for its own magazine)."
param_ranges = {
"drone_dps_pct_of_player": [25.0, 40.0],
"reload_speed_penalty_pct": [15.0, 30.0]
}
is_implemented = false
condition_id = &""
class_restriction = &""
