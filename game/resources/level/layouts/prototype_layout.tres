[gd_resource type="Resource" script_class="LevelLayout" load_steps=33 format=3]

[ext_resource type="Script" path="res://scripts/level/level_layout.gd" id="script_layout"]
[ext_resource type="Script" path="res://scripts/level/level_piece.gd" id="script_piece"]
[ext_resource type="Script" path="res://scripts/level/room_def.gd" id="script_room"]
[ext_resource type="Script" path="res://scripts/level/corridor_def.gd" id="script_corridor"]
[ext_resource type="Resource" path="res://resources/level/themes/tech_theme.tres" id="theme"]
[ext_resource type="Resource" path="res://resources/level/lights/fluorescent_white.tres" id="light_fluoro"]

; ══════════════════════════════════════════════════════════════════════════════
; SUB-LEVEL ZERO — THE PICKLE GAUNTLET (expanded)
;
; Top-down (-Z is north, +X is east). Player spawns south in the operating
; theater, picks up loot in side rooms, fights through the cross hub, collects
; three switches across the east arm and north spine, then breaches the boss
; arena to fight Pickle and reach the stairwell exit.
;
; Wall enum: NORTH=0, SOUTH=1, EAST=2, WEST=3
;
;                                              [Archive]──[Obs Hall 10x10]    <- switch 3
;                                                           (0, 0, -63)
;                                                                │
;                                                       [Sensor Corr len=12 Z, pit]
;                                                           (0, 0, -52)
;                                                                │
;                          [Spec Lab W]──[Containment Bay 14x14]──[Spec Lab E]   <- switch 2
;                          (-12,0,-39)        (0, 0, -39)        (12,0,-39)
;                                                                │
;                                                       [Crouch Corr len=8 Z]
;                                                           (0, 0, -28)
;                                                                │
;     [Stair]──[Boss Exit]──[Boss Arena 14x10]──[Approach B]──[Boss Junction]──[Approach A]──[Cross Hub 8x8]──[East A]──[East Junction]──[East B]──[Power Closet]──[Gen Corr]──[Gen Room]
;     (-41)                  (-25,0,-20)                       (-10,0,-20)                     (0,0,-20)                  (13,0,-20)              (23,0,-20)              (33,0,-20)
;        ↑                       ↑↑                                 │                              │                          │                       ↑                                  <- switch 1 (closet)
;        exit pad                3-switch east lock                 │                              │                          │
;        (boss-unlock)           boss-unlock west door     [Holding Corr]                  [Spawn Corr]               [Eng Corr]
;                                                              │                              (0,0,-12)                     │
;                                                       [Holding Pen]                          │                       [Eng Closet]
;                                                       (-10,0,-28)                  [Op Theater 8x8]──[Recov Corr]──[Recovery Ward]
;                                                                                       (0,0,-4)                     (10,0,-4)
;                                                                                          ← player spawn
; ══════════════════════════════════════════════════════════════════════════════

; ── 1. Operating Theater — player wakes here, side door east to recovery ward ──
[sub_resource type="Resource" id="room_op"]
script = ExtResource("script_room")
id = &"operating_theater"
size = Vector2(8, 8)
openings = [0, 2]
opening_width = 4.0
light_color = ExtResource("light_fluoro")

[sub_resource type="Resource" id="piece_op"]
script = ExtResource("script_piece")
position = Vector3(0, 0, -4)
room = SubResource("room_op")

; ── 2. Recovery corridor — op theater east → recovery ward ──────────────────
[sub_resource type="Resource" id="corr_recovery"]
script = ExtResource("script_corridor")
width = 4.0
length = 4.0
axis = 0
light_color = ExtResource("light_fluoro")
light_interval = 4.0

[sub_resource type="Resource" id="piece_recovery_corr"]
script = ExtResource("script_piece")
position = Vector3(6, 0, -4)
corridor = SubResource("corr_recovery")

