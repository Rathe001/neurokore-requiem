[sub_resource type="Resource" id="piece_pit_approach"]
script = ExtResource("script_piece")
position = Vector3(0, 0, 11)
corridor = SubResource("corr_pit_approach")

; ── 43. Pillar Pit — jump-puzzle room. Full-room pit, no ledge. ────────────
;  Four pillars in a straight line down the room's centre (x=0), 4m apart
;  centre-to-centre. Edge-to-edge gaps are 2.5m — easy jumps within the
;  player's ~3.5m jump range, but unmissable (you can't walk across). Entry
;  and exit pillars sit 0.25m from the doorways (bridged by capsule radius
;  + step-up). Spike-pit floor reads the missed jump as fatal — no ceiling
;  light, only a faint amber rim from below silhouettes the spikes.
[sub_resource type="Resource" id="room_pit"]
script = ExtResource("script_room")
id = &"pillar_pit"
size = Vector2(8, 14)
openings = [0, 1]
opening_width = 4.0
pit_floor = true
pit_margin = 0.0
spike_pit = true
pillars = [Vector2(0, -6), Vector2(0, -2), Vector2(0, 2), Vector2(0, 6)]
pillar_size = Vector2(1.5, 1.5)

[sub_resource type="Resource" id="piece_pit"]
script = ExtResource("script_piece")
position = Vector3(0, 0, 19)
room = SubResource("room_pit")

; ── 44. Reactor approach corridor — pit → reactor heart (teal glow) ────────
[sub_resource type="Resource" id="corr_reactor"]
script = ExtResource("script_corridor")
width = 4.0
length = 2.0
axis = 1
light_color = ExtResource("light_teal_oh")
light_interval = 2.0

[sub_resource type="Resource" id="piece_reactor_corr"]
script = ExtResource("script_piece")
position = Vector3(0, 0, 27)
corridor = SubResource("corr_reactor")

; ── 45. Reactor Heart — south-wing reward room ─────────────────────────────
[sub_resource type="Resource" id="room_reactor"]
script = ExtResource("script_room")
id = &"reactor_heart"
size = Vector2(10, 10)
openings = [0]
opening_width = 4.0
light_color = ExtResource("light_teal")
enemy_count = 4
door_openings = [0]
puddle_count = 2
puddle_size = Vector2(0.9, 1.5)

[sub_resource type="Resource" id="piece_reactor"]
script = ExtResource("script_piece")
position = Vector3(0, 0, 33)
room = SubResource("room_reactor")

; ── Layout Resource ────────────────────────────────────────────────────────

[resource]
script = ExtResource("script_layout")
theme = ExtResource("theme")
ground_size = Vector2(100, 130)
