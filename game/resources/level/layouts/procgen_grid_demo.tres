[gd_resource type="Resource" script_class="LevelLayout" load_steps=27 format=3]

; ══════════════════════════════════════════════════════════════════════════════
; PROCGEN GRID DEMO — GridGenerator builds a fully-connected 3×3 grid of
; 8×8 rooms. Cycles between rooms exercise the GraphSolver's multi-path
; position verification (BFS visits a cell from two directions and
; confirms the computed positions agree).
;
; v1 scope: pure navigation demo — no boss, no exit, no puzzles. Player
; spawns at the NW corner cell and can walk anywhere. Reseed `seed` to
; reroll corridor variants and (when sparse-grid support lands) which
; cells are filled.
;
; To preview: open level_shell.tscn, swap LevelBuilder.layout to this
; file, F6.
; ══════════════════════════════════════════════════════════════════════════════

[ext_resource type="Script" path="res://scripts/level/level_layout.gd" id="script_layout"]
[ext_resource type="Script" path="res://scripts/level/procgen/grid_generator.gd" id="script_grid"]
[ext_resource type="Script" path="res://scripts/level/procgen/room_template.gd" id="script_template"]
[ext_resource type="Resource" path="res://resources/level/themes/tech_theme.tres" id="theme"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_corner_ne.tres" id="room_ne"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_corner_nw.tres" id="room_nw"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_corner_se.tres" id="room_se"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_corner_sw.tres" id="room_sw"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_t_e.tres" id="room_t_e"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_t_w.tres" id="room_t_w"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_t_n.tres" id="room_t_n"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_t_s.tres" id="room_t_s"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grid_cross.tres" id="room_cross"]
[ext_resource type="Resource" path="res://resources/level/corridors/proto_corridor_standard.tres" id="corr_std"]
[ext_resource type="Resource" path="res://resources/level/corridors/proto_corridor_long.tres" id="corr_long"]
[ext_resource type="Resource" path="res://resources/level/corridors/proto_corridor_dim.tres" id="corr_dim"]

[sub_resource type="Resource" id="tpl_ne"]
script = ExtResource("script_template")
room = ExtResource("room_ne")

[sub_resource type="Resource" id="tpl_nw"]
script = ExtResource("script_template")
room = ExtResource("room_nw")

[sub_resource type="Resource" id="tpl_se"]
script = ExtResource("script_template")
room = ExtResource("room_se")

[sub_resource type="Resource" id="tpl_sw"]
script = ExtResource("script_template")
room = ExtResource("room_sw")

[sub_resource type="Resource" id="tpl_t_e"]
script = ExtResource("script_template")
room = ExtResource("room_t_e")

[sub_resource type="Resource" id="tpl_t_w"]
script = ExtResource("script_template")
room = ExtResource("room_t_w")

[sub_resource type="Resource" id="tpl_t_n"]
script = ExtResource("script_template")
room = ExtResource("room_t_n")

[sub_resource type="Resource" id="tpl_t_s"]
script = ExtResource("script_template")
room = ExtResource("room_t_s")

[sub_resource type="Resource" id="tpl_cross"]
script = ExtResource("script_template")
room = ExtResource("room_cross")

[sub_resource type="Resource" id="generator"]
script = ExtResource("script_grid")
rng_seed = 7
templates = [SubResource("tpl_ne"), SubResource("tpl_nw"), SubResource("tpl_se"), SubResource("tpl_sw"), SubResource("tpl_t_e"), SubResource("tpl_t_w"), SubResource("tpl_t_n"), SubResource("tpl_t_s"), SubResource("tpl_cross")]
corridor_pool = [ExtResource("corr_std"), ExtResource("corr_long"), ExtResource("corr_dim")]
grid_width = 3
grid_height = 3
anchor_position = Vector3(0, 0, 0)
boss_cell = Vector2i(2, 2)
exit_cell = Vector2i(2, 2)
boss_level_range = Vector2i(3, 4)
emit_switch_puzzle = true
switch_count = 2

[resource]
script = ExtResource("script_layout")
theme = ExtResource("theme")
ground_size = Vector2(80, 80)
generator = SubResource("generator")
