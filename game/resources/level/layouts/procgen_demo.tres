[gd_resource type="Resource" script_class="LevelLayout" load_steps=72 format=3]

; ══════════════════════════════════════════════════════════════════════════════
; PROCGEN DEMO — BranchingGenerator builds a 10-14 room east-going chain with
; T-junctions and 2-4 room dead-end branches. Final connection is locked
; behind a SwitchDoorPuzzle whose switches sit in the branch terminators;
; each branch entrance is independently lockable behind a ClearRoomPuzzle on
; the junction. Boss arena uses the amber theme to mark the end.
;
; Room pool includes asylum/facility themed rooms (cell blocks, mess halls,
; medical wards, security checkpoints, isolation wings) and pit-as-design-
; element rooms (bridges, islands, crossings). Start/end/junction/branch
; roles use larger variants for roomier fights. ~85% of connections get doors.
;
; Expected output: 10-14 room chain + ~5-7 branches of depth 2-4 = 25-40 rooms.
; ══════════════════════════════════════════════════════════════════════════════

[ext_resource type="Script" path="res://scripts/level/level_layout.gd" id="script_layout"]
[ext_resource type="Script" path="res://scripts/level/procgen/branching_generator.gd" id="script_branching"]
[ext_resource type="Script" path="res://scripts/level/procgen/room_template.gd" id="script_template"]
[ext_resource type="Resource" path="res://resources/level/themes/tech_theme.tres" id="theme"]
[ext_resource type="Resource" path="res://resources/level/themes/amber_theme.tres" id="theme_amber"]
[ext_resource type="Resource" path="res://resources/level/themes/dim_theme.tres" id="theme_dim"]

; ── Role rooms (larger variants) ─────────────────────────────────────────────
[ext_resource type="Resource" path="res://resources/level/rooms/proto_start_room_large.tres" id="room_start"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_end_room_large.tres" id="room_end"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_junction_t_south_large.tres" id="room_t_south"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_junction_t_north_large.tres" id="room_t_north"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_branch_north_large.tres" id="room_branch_n"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_branch_south_large.tres" id="room_branch_s"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_branch_linear_ns_large.tres" id="room_branch_linear"]

; ── Existing linear rooms ────────────────────────────────────────────────────
[ext_resource type="Resource" path="res://resources/level/rooms/proto_linear_room.tres" id="room_linear"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_wide_linear.tres" id="room_wide_linear"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_great_hall.tres" id="room_great_hall"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_open_arena.tres" id="room_open_arena"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_grand_arena.tres" id="room_grand_arena"]

; ── Pit jump rooms ───────────────────────────────────────────────────────────
[ext_resource type="Resource" path="res://resources/level/rooms/proto_pit_linear.tres" id="room_pit_linear"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_pit_chasm.tres" id="room_pit_chasm"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_spike_chamber.tres" id="room_spike_chamber"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_pit_bottomless.tres" id="room_pit_bottomless"]

; ── Themed facility rooms ────────────────────────────────────────────────────
[ext_resource type="Resource" path="res://resources/level/rooms/proto_cell_block.tres" id="room_cell_block"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_mess_hall.tres" id="room_mess_hall"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_medical_ward.tres" id="room_medical_ward"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_security_checkpoint.tres" id="room_security"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_isolation_wing.tres" id="room_isolation"]

; ── Pit design-element rooms ─────────────────────────────────────────────────
[ext_resource type="Resource" path="res://resources/level/rooms/proto_pit_bridge.tres" id="room_pit_bridge"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_pit_island.tres" id="room_pit_island"]
[ext_resource type="Resource" path="res://resources/level/rooms/proto_pit_crossing.tres" id="room_pit_crossing"]

; ── Corridors ────────────────────────────────────────────────────────────────
[ext_resource type="Resource" path="res://resources/level/corridors/proto_corridor_standard.tres" id="corr_std"]
[ext_resource type="Resource" path="res://resources/level/corridors/proto_corridor_long.tres" id="corr_long"]
[ext_resource type="Resource" path="res://resources/level/corridors/proto_corridor_dim.tres" id="corr_dim"]
[ext_resource type="Resource" path="res://resources/level/corridors/proto_corridor_crouch.tres" id="corr_crouch"]

; ══════════════════════════════════════════════════════════════════════════════
; TEMPLATES
; ══════════════════════════════════════════════════════════════════════════════

[sub_resource type="Resource" id="template_start"]
script = ExtResource("script_template")
room = ExtResource("room_start")
role = &"start"

; ── Linear templates (existing) ──────────────────────────────────────────────

[sub_resource type="Resource" id="template_linear"]
script = ExtResource("script_template")
room = ExtResource("room_linear")
role = &"linear"
weight = 1.0

[sub_resource type="Resource" id="template_wide_linear"]
script = ExtResource("script_template")
room = ExtResource("room_wide_linear")
role = &"linear"
weight = 0.8

[sub_resource type="Resource" id="template_great_hall"]
script = ExtResource("script_template")
room = ExtResource("room_great_hall")
role = &"linear"
weight = 0.4

[sub_resource type="Resource" id="template_open_arena"]
script = ExtResource("script_template")
room = ExtResource("room_open_arena")
role = &"linear"
weight = 0.5

[sub_resource type="Resource" id="template_grand_arena"]
script = ExtResource("script_template")
room = ExtResource("room_grand_arena")
role = &"linear"
weight = 0.25

; ── Pit jump templates ───────────────────────────────────────────────────────

[sub_resource type="Resource" id="template_pit_linear"]
script = ExtResource("script_template")
room = ExtResource("room_pit_linear")
role = &"linear"
weight = 0.35

[sub_resource type="Resource" id="template_pit_chasm"]
script = ExtResource("script_template")
room = ExtResource("room_pit_chasm")
role = &"linear"
weight = 0.25

[sub_resource type="Resource" id="template_spike_chamber"]
script = ExtResource("script_template")
room = ExtResource("room_spike_chamber")
role = &"linear"
weight = 0.20

[sub_resource type="Resource" id="template_pit_bottomless"]
script = ExtResource("script_template")
room = ExtResource("room_pit_bottomless")
role = &"linear"
weight = 0.20

; ── Themed facility templates ────────────────────────────────────────────────

[sub_resource type="Resource" id="template_cell_block"]
script = ExtResource("script_template")
room = ExtResource("room_cell_block")
role = &"linear"
weight = 0.5

[sub_resource type="Resource" id="template_mess_hall"]
script = ExtResource("script_template")
room = ExtResource("room_mess_hall")
role = &"linear"
weight = 0.4

[sub_resource type="Resource" id="template_medical_ward"]
script = ExtResource("script_template")
room = ExtResource("room_medical_ward")
role = &"linear"
weight = 0.5

[sub_resource type="Resource" id="template_security"]
script = ExtResource("script_template")
room = ExtResource("room_security")
role = &"linear"
weight = 0.6

[sub_resource type="Resource" id="template_isolation"]
script = ExtResource("script_template")
room = ExtResource("room_isolation")
role = &"linear"
weight = 0.3

; ── Pit design-element templates ─────────────────────────────────────────────

[sub_resource type="Resource" id="template_pit_bridge"]
script = ExtResource("script_template")
room = ExtResource("room_pit_bridge")
role = &"linear"
weight = 0.3

[sub_resource type="Resource" id="template_pit_island"]
script = ExtResource("script_template")
room = ExtResource("room_pit_island")
role = &"linear"
weight = 0.2

[sub_resource type="Resource" id="template_pit_crossing"]
script = ExtResource("script_template")
room = ExtResource("room_pit_crossing")
role = &"linear"
weight = 0.25

; ── End / junction / branch templates ────────────────────────────────────────

[sub_resource type="Resource" id="template_end"]
script = ExtResource("script_template")
room = ExtResource("room_end")
role = &"end"

[sub_resource type="Resource" id="template_t_south"]
script = ExtResource("script_template")
room = ExtResource("room_t_south")
role = &"junction_t_south"

[sub_resource type="Resource" id="template_t_north"]
script = ExtResource("script_template")
room = ExtResource("room_t_north")
role = &"junction_t_north"

[sub_resource type="Resource" id="template_branch_n"]
script = ExtResource("script_template")
room = ExtResource("room_branch_n")
role = &"branch_north"

[sub_resource type="Resource" id="template_branch_s"]
script = ExtResource("script_template")
room = ExtResource("room_branch_s")
role = &"branch_south"

[sub_resource type="Resource" id="template_branch_linear"]
script = ExtResource("script_template")
room = ExtResource("room_branch_linear")
role = &"branch_linear_ns"

; ══════════════════════════════════════════════════════════════════════════════
; GENERATOR
; ══════════════════════════════════════════════════════════════════════════════

[sub_resource type="Resource" id="generator"]
script = ExtResource("script_branching")
rng_seed = 42
templates = [SubResource("template_start"), SubResource("template_linear"), SubResource("template_pit_linear"), SubResource("template_wide_linear"), SubResource("template_great_hall"), SubResource("template_open_arena"), SubResource("template_grand_arena"), SubResource("template_pit_chasm"), SubResource("template_spike_chamber"), SubResource("template_pit_bottomless"), SubResource("template_cell_block"), SubResource("template_mess_hall"), SubResource("template_medical_ward"), SubResource("template_security"), SubResource("template_isolation"), SubResource("template_pit_bridge"), SubResource("template_pit_island"), SubResource("template_pit_crossing"), SubResource("template_end"), SubResource("template_t_south"), SubResource("template_t_north"), SubResource("template_branch_n"), SubResource("template_branch_s"), SubResource("template_branch_linear")]
; Corridor pool — each non-crouch corridor is duped twice and crouch
; appears once, so the picker (uniform random) lands on a non-crouch
; corridor ~6/7 of the time.
corridor_pool = [ExtResource("corr_std"), ExtResource("corr_std"), ExtResource("corr_long"), ExtResource("corr_long"), ExtResource("corr_dim"), ExtResource("corr_dim"), ExtResource("corr_crouch")]
min_length = 10
max_length = 14
branch_chance = 0.5
min_branch_depth = 2
max_branch_depth = 4
anchor_position = Vector3(0, 0, 0)
emit_switch_puzzle = true
place_loot_at_branches = true
door_chance = 0.85
lock_branch_with_clear_chance = 0.5
end_theme = ExtResource("theme_amber")
chain_themes = [ExtResource("theme_dim")]
boss_arena_minions = 3
packed_room_chance = 0.3
packed_room_extra_enemies = 2

[resource]
script = ExtResource("script_layout")
theme = ExtResource("theme")
ground_size = Vector2(320, 120)
generator = SubResource("generator")
