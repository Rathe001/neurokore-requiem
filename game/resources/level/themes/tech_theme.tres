[gd_resource type="Resource" script_class="LevelTheme" load_steps=2 format=3]

; Production tech theme — fully procedural walls + floors. wall_model and
; floor_model both null → both fall back to procedural geometry, which
; BuildContext.\_default_{wall,floor}_material wraps in the shared
; procedural_wall.gdshader (worn steel panel look). Toggle
; USE_DEBUG_LEVEL_VIZ in level_builder to render the debug ShaderMaterials
; from res://resources/level/debug/ instead.

[ext_resource type="Script" path="res://scripts/level/level_theme.gd" id="1"]

[resource]
script = ExtResource("1")
fps_fog_density = 0.35
fps_fog_color = Color(0.002, 0.003, 0.006, 1)
wall_height = 3.0
wall_thickness = 0.4
wall_grid_size = 4.0
floor_grid_size = 4.0
wall_model_native_width = 2.71
wall_model_native_height = 3.0
floor_model_native_size = Vector2(1.92, 2.0)
fluorescent_housing_size = Vector3(1.2, 0.25, 0.1)
fluorescent_tube_size = Vector3(1.05, 0.12, 0.03)
fluorescent_housing_color = Color(0.12, 0.12, 0.13, 1)
fluorescent_housing_metallic = 0.5
fluorescent_housing_roughness = 0.5
fluorescent_emission_multiplier = 44.0
