[gd_resource type="Resource" script_class="LevelTheme" load_steps=4 format=3]

; Production tech theme — kit-bash models. Material slots intentionally
; null; pillars/trim/low-ceilings use the dark-grey fallback inside
; WallBuilder. When LevelBuilder.USE_DEBUG_LEVEL_VIZ is true, BuildContext
; loads the debug ShaderMaterials from res://resources/level/debug/
; instead of reading these slots — no theme edits needed to toggle.

