[gd_resource type="Resource" script_class="RoomDef" load_steps=3 format=3]

; Linear-role pit-floor jump room — 10x6 with 3 pillars across the chasm.
; pit_margin = 0 so there's NO perimeter ledge — the player has to step
; from the corridor directly onto the entry pillar (placed flush with
; the wall). Three jumps to cross. Drop into the pit = kill zone.

[ext_resource type="Script" path="res://scripts/level/room_def.gd" id="1"]
[ext_resource type="Resource" path="res://resources/level/lights/fluorescent_white.tres" id="light"]

[resource]
script = ExtResource("1")
id = &"proto_pit_linear"
size = Vector2(10, 6)
openings = [3, 2]
opening_width = 4.0
light_color = ExtResource("light")
pit_floor = true
pit_margin = 0.0
pillars = [Vector2(-4.25, 0), Vector2(0, 0), Vector2(4.25, 0)]
pillar_size = Vector2(1.5, 1.5)
