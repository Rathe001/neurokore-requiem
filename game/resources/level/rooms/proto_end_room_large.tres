[gd_resource type="Resource" script_class="RoomDef" load_steps=6 format=3]

; Larger boss arena — 16x16 with 4 decorative pillars for cover during
; the fight. Boss spawns at centre, exit pad to the east. Generous space
; so ranged builds can kite and melee builds can weave between columns.

