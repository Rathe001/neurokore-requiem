[gd_resource type="Resource" script_class="RoomDef" load_steps=3 format=3]

; Reusable through-traffic template — WEST + EAST openings so it slots into
; the middle of an east-going chain. Carries a small enemy spawn so the
; generated chain isn't empty.

[ext_resource type="Script" path="res://scripts/level/room_def.gd" id="1"]
[ext_resource type="Resource" path="res://resources/level/lights/fluorescent_white.tres" id="light"]

[resource]
script = ExtResource("1")
id = &"proto_linear_room"
size = Vector2(8, 8)
openings = [3, 2]
opening_width = 4.0
light_color = ExtResource("light")
enemy_count = 1
