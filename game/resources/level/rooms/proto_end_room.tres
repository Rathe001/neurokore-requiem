[gd_resource type="Resource" script_class="RoomDef" load_steps=6 format=3]

; Reusable end-room template — single WEST opening (terminates the chain).
; Boss arena variant: a boss spawn at centre and an exit pad to the east.
; PrototypeExit auto-joins &"boss_listeners" so it unlocks on boss death;
; once unlocked, interacting with it triggers PrototypeRoot.reset_level
; (= NG+). 12x12 to give room for the fight.

[ext_resource type="Script" path="res://scripts/level/room_def.gd" id="1"]
[ext_resource type="Script" path="res://scripts/level/interactable_slot.gd" id="2"]
[ext_resource type="Resource" path="res://resources/level/lights/fluorescent_white.tres" id="light"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_boss_spawn.tscn" id="boss_spawn"]
[ext_resource type="PackedScene" path="res://scenes/prototype/prototype_exit.tscn" id="exit"]

[sub_resource type="Resource" id="slot_boss"]
script = ExtResource("2")
id = &"boss"
scene = ExtResource("boss_spawn")
offset = Vector3(0, 0, 0)

[sub_resource type="Resource" id="slot_exit"]
script = ExtResource("2")
id = &"exit"
scene = ExtResource("exit")
offset = Vector3(4, 0, 0)

[resource]
script = ExtResource("1")
id = &"proto_end_room"
size = Vector2(12, 12)
openings = [3]
opening_width = 4.0
light_color = ExtResource("light")
slots = [SubResource("slot_boss"), SubResource("slot_exit")]
