[gd_resource type="Resource" script_class="Skill" load_steps=2 format=3]

; Unarmed fallback — fires when no weapon is equipped. Weak short-range
; punch so the player is never completely helpless. Glove stat_modifiers
; (unarmed_damage_bonus, unarmed_stun_chance, unarmed_aoe_radius) can
; upgrade it into a viable melee option.

[ext_resource type="Script" path="res://scripts/skills/skill.gd" id="1_skill_script"]

[resource]
script = ExtResource("1_skill_script")
display_name = "Unarmed Strike"
glyph = "P"
; Sped up to read as a rapid jab combo instead of slow telegraphed
; swings. Per-hit damage scaled down proportionally so DPS stays put.
; Previously: damage = 5 / cooldown = 0.5 / wind_up = 0.1 (10 DPS).
; Now:        damage = 3 / cooldown = 0.3 / wind_up = 0.0 (10 DPS).
; wind_up zeroed because _fire_unarmed schedules its own impact-frame
; delay (cooldown × 0.5) so the punch sound + damage land mid-anim
; rather than at press time.
damage = 3
skill_range = 2.0
cooldown = 0.3
wind_up = 0.0
resource_cost = 0
targeting_mode = 0
cone_deg = 45.0
knockback = 1.0
icon_color = Color(0.6, 0.6, 0.6, 1.0)
