; Swing duration controlled by cooldown — the LMB melee path uses
; cooldown / atk_spd as the stretched anim duration (and the damage
; timer fires at impact_ratio * that duration). 0.7 made swings feel
; rushed even after halving attack_speed; bumped to 1.5 so the slow
; weapon range (atk_spd 0.4-0.55) produces 2.7-3.75s swings, letting
; the sword_attack clip play closer to its natural pace instead of
; getting stretched to fit a too-short window.
cooldown = 1.5
wind_up = 0.22
resource_cost = 10
targeting_mode = 0
cone_deg = 60.0
