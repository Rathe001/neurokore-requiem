skill_range = 3.5
; Swing duration controlled by cooldown — the LMB melee path uses
; cooldown / atk_spd as the stretched anim duration (and the damage
; timer fires at impact_ratio * that duration). 1.5 over-corrected
; from the previous 0.7 — combined with the lowered atk_spd_range
; (0.4-0.55) it produced 2.7-3.8s swings, which crushed melee DPS to
; ~7 vs pistols at ~25. 0.85 lands the swing window at 1.55-2.13s;
; the anim plays close to its natural ~1.5s clip length without
; stretching past readable, and DPS climbs to ~17-18 (paired with
; the damage bump on melee_1h.tres).
cooldown = 0.85
wind_up = 0.22
resource_cost = 10
targeting_mode = 0
cone_deg = 60.0
knockback = 0.0
icon_color = Color(0.7, 0.9, 1.0, 1.0)
