[gd_resource type="Resource" script_class="Skill" load_steps=2 format=3]

; Active offhand — Active Shield. Hold RMB to block 100% of incoming
; damage up to shield_pool. Releasing RMB drops the shield WITHOUT
; cooldown but the pool persists, so partial-pool tap-spam doesn't
; refresh. Pool resets only on the first activation after the shield
; has been broken (cooldown gates re-pressing during cooldown).
;
; active_kind = SHIELD_HOLD (1 in the enum order).
; damage_reduction is hard-coded to 1.0 by the player when activating
; SHIELD_HOLD (full block); the field here is set for clarity but
; ignored at activation time.

[ext_resource type="Script" path="res://scripts/skills/skill.gd" id="1_skill_script"]

