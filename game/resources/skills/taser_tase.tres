[gd_resource type="Resource" script_class="Skill" load_steps=2 format=3]

; Charged Arc Taser primary — "Tase". Hold LMB to channel a chained
; lightning arc. Each tick damages the primary target and bounces to
; the nearest unstruck enemy within chain_jump_radius, with a 15%
; damage falloff per jump. Chain stops when running damage drops
; below chain_min_damage. No jump cap (chain_jumps = 0) — the falloff
; itself terminates the bounce. Resource drains continuously while
; held; stops on release or empty pool.

