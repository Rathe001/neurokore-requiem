[ext_resource type="Script" path="res://scripts/items/weapon_base.gd" id="1_weapon_base"]
[ext_resource type="Resource" path="res://resources/skills/basic_attack.tres" id="2_fire_skill"]

[resource]
script = ExtResource("1_weapon_base")
id = &"melee_1h"
display_name = "Blade"
glyph = "†"
two_handed = false
; Blade tuning, snappy zip pass. User wants the 1H blade to read as
; a high-mobility skirmisher — zipping between enemies, lower damage
; per hit but lots of hits per second. atk_spd_range bumped to
; (1.0, 1.4); paired with basic_attack cooldown 0.85 the swing window
; lands at 0.61-0.85s. The lunge duration (cooldown/atk_spd × 0.5)
; drops to ~0.32s, well into "dart" territory rather than glide.
; Damage cut to ~half so DPS lands ~24 instead of 32 — close to
; ranged target without overshooting from the close-range commit.
; Previously: damage (10,15)/(24,36), atk_spd (0.4, 0.55).
damage_min_range = Vector2(8, 14)
damage_max_range = Vector2(18, 28)
attack_speed_range = Vector2(1.0, 1.4)
crit_chance_range = Vector2(0.0, 0.0)
accuracy_range = Vector2(0.92, 0.98)
weapon_range_range = Vector2(2.5, 3.5)
fire_skill = ExtResource("2_fire_skill")
model_names = Array[String](["Stiletto", "Karambit", "Bowie Knife", "Tanto", "Cleaver"])
