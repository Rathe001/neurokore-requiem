[gd_resource type="Resource" script_class="WeaponBase" load_steps=3 format=3]

; SMG (1H) — fast spray bullet weapon. Modest per-shot damage, high
; attack-speed (1.6–2.2× cycle on a 0.25s base), low accuracy. 25–50
; round magazine with fast reload (1.5s). Tuned to ~24 raw DPS (limited
; multi-target tier via ricochet). The spray cadence + 50–100% ricochet
; gives reliable multi-target damage and hit-on-crit stacking.

