[gd_resource type="Resource" script_class="WeaponBase" load_steps=3 format=3]

; SMG (1H) — fast spray bullet weapon. Tiny per-shot damage, very high
; attack-speed (1.6–2.2× cycle on a 0.15s base), low accuracy. Smaller
; magazine (10–50 rounds) but a fast reload (1.5s) keeps it spammable.
; Tuned to ~22 raw DPS to match the other archetypes; the spray cadence
; lets it reliably stack hit-on-crit and hit-aggro effects despite the
; small numbers per individual round.

[ext_resource type="Script" path="res://scripts/items/weapon_base.gd" id="1_weapon_base"]
[ext_resource type="Resource" path="res://resources/skills/smg_burst.tres" id="2_fire_skill"]

