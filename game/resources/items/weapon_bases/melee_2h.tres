[resource]
script = ExtResource("1_weapon_base")
id = &"melee_2h"
display_name = "Sledgehammer"
glyph = "‡"
two_handed = true
; Sledge stance — attack_speed_range stays low (0.3-0.4) so each strike
; clearly winds up + commits, but melee_2h_attack cooldown dropped
; 0.7 → 0.50 to lift swings out of the 2s+ range that made melee feel
; punishing vs ranged. Damage bumped ~1.6× alongside the cooldown drop
; to land DPS around 18-19 (close to ranged target).
; Previously: damage (9,14)/(22,32).
damage_min_range = Vector2(14, 22)
damage_max_range = Vector2(35, 50)
attack_speed_range = Vector2(0.3, 0.4)
crit_chance_range = Vector2(0.0, 0.0)
accuracy_range = Vector2(0.85, 0.94)
weapon_range_range = Vector2(3.0, 4.5)
fire_skill = ExtResource("2_fire_skill")
alt_fire_skill = ExtResource("3_alt_fire")
model_names = Array[String](["Sledgehammer", "Maul", "Warhammer", "Pile-Driver", "Bludgeon"])
