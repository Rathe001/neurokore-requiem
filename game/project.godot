; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Neurokore: Requiem"
run/main_scene="res://scenes/ui/startup_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

BuildInfo="*res://scripts/systems/build_info.gd"
SteamState="*res://scripts/systems/steam_state.gd"
NetState="*res://scripts/systems/net_state.gd"
GlobalChatState="*res://scripts/systems/global_chat_state.gd"
GameplayChatState="*res://scripts/systems/gameplay_chat_state.gd"
DebugState="*res://scripts/systems/debug_state.gd"
AccessibilityState="*res://scripts/systems/accessibility_state.gd"
PlayerState="*res://scripts/systems/player_state.gd"
LocaleState="*res://scripts/systems/locale_state.gd"
DisplayState="*res://scripts/systems/display_state.gd"
UIThemeState="*res://scripts/systems/ui_theme_state.gd"
InputSetup="*res://scripts/systems/input_setup.gd"
SpatialGrid="*res://scripts/systems/spatial_grid.gd"
EntityPool="*res://scripts/systems/entity_pool.gd"
SlotRegistry="*res://scripts/systems/slot_registry.gd"
InventoryState="*res://scripts/systems/inventory_state.gd"
AttributeState="*res://scripts/systems/attribute_state.gd"
PerkState="*res://scripts/systems/perk_state.gd"
TalentState="*res://scripts/systems/talent_state.gd"
AffixTable="*res://scripts/items/affix_table.gd"
MonsterAffixTable="*res://scripts/enemies/monster_affix_table.gd"
NamedMonsterTable="*res://scripts/enemies/named_monster_table.gd"
EnemyClassTable="*res://scripts/enemies/enemy_class_table.gd"
ItemRoller="*res://scripts/items/item_roller.gd"
LosCuller="*res://scripts/systems/los_culler.gd"
ProximityLighting="*res://scripts/systems/proximity_lighting.gd"
OverhangFader="*res://scripts/systems/overhang_fader.gd"
Traction="*res://scripts/systems/traction.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
CombatVisuals="*res://scripts/systems/combat_visuals.gd"
RoomAcoustics="*res://scripts/audio/room_acoustics.gd"
SFX="*res://scripts/audio/sfx.gd"
WeaponSounds="*res://scripts/audio/weapon_sounds.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Enemies"
3d_physics/layer_3="Player"
3d_physics/layer_4="Pickups"
3d_physics/layer_6="Corpses"
3d_physics/layer_7="Interactables"
3d_physics/layer_8="Pillars"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
anti_aliasing/quality/use_taa=true

[shader_globals]

player_world_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

[steam]

initialization/app_id=0
initialization/initialize_on_startup=false
initialization/embed_callbacks=false
multiplayer_peer/max_channels=4
