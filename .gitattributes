# Normalize all text files to LF on commit, checkout as-is.
* text=auto eol=lf

# Explicitly binary — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.glb binary
*.gltf binary
*.blend binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.import binary
*.tres binary
*.res binary
