# Normalize all text files to LF on commit, checkout as-is.
* text=auto eol=lf

# Explicitly binary — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.gltf binary
*.blend binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.import binary
*.tres binary
*.res binary
*.fbx filter=lfs diff=lfs merge=lfs -text
# .glb tracked in LFS — weapon / prop models run 0.5–14 MB each and are
# iterated (re-imports, decimation tweaks), so keeping them out of the
# main pack history matters. Pre-existing glbs committed before this
# rule (e.g. switch_console) stay as regular blobs; only new commits
# route through LFS.
*.glb filter=lfs diff=lfs merge=lfs -text
