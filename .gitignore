# Neurokore: Requiem .gitignore
# Add engine/language-specific rules here once tech stack is decided

# MkDocs build output
site/

# Godot exported builds (Steam, etc.) — anchored to repo root only,
# otherwise this swallows source dirs named "build/" like game/scripts/level/build/.
/build/

# Claude / yt-extract scratch space. Audio splitting, downloaded
# sources, anything ephemeral that shouldn't enter version control.
/.tmp/

# macOS
.DS_Store

# Per-machine Claude Code session config (permission allowlists, etc.).
# .claude/settings.json stays tracked (project-shared); only the .local
# variant is per-machine. Untracked once via `git rm --cached`.
.claude/settings.local.json

# Windows leaves these tilde-prefixed temp files next to a DLL when
# something held the file open during a write — Godot re-importing the
# GodotSteam GDExtension is the usual culprit. They're not real artifacts.
~*.dll
~*.dll~*.TMP

# Python bytecode
__pycache__/

# Phantom PNG bookkeeping Godot writes when an FBX references textures it
# can't actually extract (Meshy/Mixamo standalone FBXs hardcode /tmp/
# texture paths and don't embed the image data). The .png file never lands
# on disk; only a .png.import companion gets created pointing at the
# missing file. Real textures next to these characters use the
# Meshy_AI_*_texture*.png naming and are tracked normally.
game/assets/characters/player_*/player_*_[0-9].png
game/assets/characters/player_*/player_*_[0-9].png.import
game/assets/characters/crimson_vein_titan/crimson_vein_titan_[0-9].png
game/assets/characters/crimson_vein_titan/crimson_vein_titan_[0-9].png.import
game/assets/characters/molten_sentinel/molten_sentinel_[0-9].png
game/assets/characters/molten_sentinel/molten_sentinel_[0-9].png.import
*.pyc
